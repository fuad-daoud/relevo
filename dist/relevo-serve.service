[Unit]
Description=relevo serve - remote builders for enrolled relevo clients
# relevo serve reaches relevo.db through the local daemon's owner socket like
# any other client, so the unit pulls the user daemon in and starts after it.
Wants=relevo.service
After=default.target relevo.service

[Service]
Type=simple
# The daemon execs the harness CLIs by PATH lookup, and a user unit inherits
# no login shell PATH, so it has to be named here.
Environment=PATH=%h/.local/bin:%h/go/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/relevo serve --listen :7777
Restart=on-failure
RestartSec=5
# No MemoryMax: builders started with `relevo add` are children of the
# daemon and share this unit's cgroup. A cap sized for the daemon
# (once 128M) OOM-killed a single `claude -p`, and the default
# OOMPolicy=stop then took the daemon down with it (#120).
# An OOM-killed builder is an exited builder: the daemon sees it on the
# next tick and switches or halts as policy says. The daemon itself
# holds no long-lived state; it rebuilds from ~/.local/state/relevo and a
# live builder probe on every start.
OOMPolicy=continue

[Install]
WantedBy=default.target
