      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790853329648,
      "link": null,
      "locked": false,
      "text": "join: merge the branches; a conflict becomes a merge round that is reviewed; the check runs on the merge.\nA child that halts lets its siblings finish, then the parent halts with that reason.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 32,
      "containerId": null,
      "originalText": "join: merge the branches; a conflict becomes a merge round that is reviewed; the check runs on the merge.\nA child that halts lets its siblings finish, then the parent halts with that reason.",
      "lineHeight": 1.25
    },
