    {
      "id": "eL5kCsS1x-cxHlw9Y5tOG",
      "type": "text",
      "x": 1150,
      "y": 480,
      "width": 488.5666809082031,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1682670425,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790853329650,
      "link": null,
      "locked": false,
      "text": "- checked before anything starts: every edge's target exists,\n  every outcome it matches is one the actor declares\n- every loop carries a budget (today's max corrections)\n- an outcome with no matching edge halts, with that reason\n- the workflow is copied into the chain at start: an edit\n  never changes a running chain\n- one engine (Next) runs every workflow, shipped or yours:\n  same trace, same single delivery, same --resume",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 154,
      "containerId": null,
      "originalText": "- checked before anything starts: every edge's target exists,\n  every outcome it matches is one the actor declares\n- every loop carries a budget (today's max corrections)\n- an outcome with no matching edge halts, with that reason\n- the workflow is copied into the chain at start: an edit\n  never changes a running chain\n- one engine (Next) runs every workflow, shipped or yours:\n  same trace, same single delivery, same --resume",
      "lineHeight": 1.25
    },
