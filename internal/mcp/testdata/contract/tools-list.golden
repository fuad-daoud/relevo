{
  "tools": [
    {
      "description": "One binding, or every binding on this MasterMind, or (all: true) every binding relevo knows about. Calls relevo.Status.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "all": {
            "description": "include every binding relevo knows about, not just this MasterMind's",
            "type": "boolean"
          },
          "name": {
            "description": "show only this binding",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "status"
    },
    {
      "description": "Hand a binding's runner a new round: stage file as the round's plan and prompt the runner. Calls relevo.Send, or relevo.SendDryRun when dry_run is true.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "candidate": {
            "description": "candidate name or token to run this round and later ones on (persists); refused while a live round is open (a halted served round may be re-pointed)",
            "type": "string"
          },
          "dry_run": {
            "description": "check preconditions and report what send would do, without sending",
            "type": "boolean"
          },
          "file": {
            "description": "path to the plan file",
            "type": "string"
          },
          "name": {
            "description": "binding name",
            "type": "string"
          },
          "regate": {
            "description": "automatic repair rounds after a failing gate; 0 disables",
            "type": "integer"
          },
          "tier": {
            "description": "permission tier override: harness|read|edit|yolo",
            "type": "string"
          },
          "verify": {
            "description": "run a read-only reviewer when the round closes",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "file"
        ],
        "type": "object"
      },
      "name": "send"
    },
    {
      "description": "Mark a binding done once its round is verified; relaying stops. A name that is a chain releases every member instead. Calls relevo.Done.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "binding name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "name": "done"
    },
    {
      "description": "One round of a binding: its prompt (the default), report, diff, drift, log, transcript, gate log, output or artifact list. Calls relevo.Show.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "binding name",
            "type": "string"
          },
          "round": {
            "description": "the round to read; omit for the newest completed round",
            "type": "integer"
          },
          "section": {
            "description": "prompt (the default) | report | diff | drift | log | transcript | gate | output | artifacts",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "name": "show"
    },
    {
      "description": "Record that a provider hit a usage limit -- relevo switches and resends -- or clear the gate again. Calls relevo's gate ledger.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "clear": {
            "description": "clear the gate instead of setting one",
            "type": "boolean"
          },
          "for": {
            "description": "how long the gate holds, as a Go duration (e.g. 2h); omit to hold until cleared",
            "type": "string"
          },
          "reason": {
            "description": "why, for the record",
            "type": "string"
          },
          "token": {
            "description": "candidate name or token to gate, or the subject to clear",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "name": "gate"
    }
  ]
}