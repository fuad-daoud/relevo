index artifact_round_kind_consult_uidx artifact
CREATE UNIQUE INDEX IF NOT EXISTS artifact_round_kind_consult_uidx ON artifact (round_id, kind, consult_id)

index binding_feature_idx binding
CREATE INDEX IF NOT EXISTS binding_feature_idx ON binding (feature)

index binding_mastermind_id_idx binding
CREATE INDEX IF NOT EXISTS binding_mastermind_id_idx ON binding (mastermind_id)

index binding_name_created_at_uidx binding
CREATE UNIQUE INDEX IF NOT EXISTS binding_name_created_at_uidx ON binding (origin, name, created_at)

index binding_record_origin_idx binding_record
CREATE INDEX IF NOT EXISTS binding_record_origin_idx ON binding_record (origin)

index binding_record_origin_owner_name_uidx binding_record
CREATE UNIQUE INDEX IF NOT EXISTS binding_record_origin_owner_name_uidx ON binding_record (origin, owner, name) WHERE archived_at IS NULL

index binding_repo_id_idx binding
CREATE INDEX IF NOT EXISTS binding_repo_id_idx ON binding (repo_id)

index chains_origin_owner_name_uidx chains
CREATE UNIQUE INDEX IF NOT EXISTS chains_origin_owner_name_uidx ON chains (origin, owner, name)

index chains_owner_builder_idx chains
CREATE INDEX IF NOT EXISTS chains_owner_builder_idx ON chains (owner, builder)

index chains_owner_planner_idx chains
CREATE INDEX IF NOT EXISTS chains_owner_planner_idx ON chains (owner, planner)

index chains_owner_reviewer_idx chains
CREATE INDEX IF NOT EXISTS chains_owner_reviewer_idx ON chains (owner, reviewer)

index chains_owner_security_idx chains
CREATE INDEX IF NOT EXISTS chains_owner_security_idx ON chains (owner, security)

index event_binding_round_seq_idx event
CREATE INDEX IF NOT EXISTS event_binding_round_seq_idx ON event (binding_id, round_id, seq)

index event_binding_seq_uidx event
CREATE UNIQUE INDEX IF NOT EXISTS event_binding_seq_uidx ON event (binding_id, seq)

index mastermind_origin_harness_session_uidx mastermind
CREATE UNIQUE INDEX IF NOT EXISTS mastermind_origin_harness_session_uidx ON mastermind (origin, harness_kind, session_id)

index repo_origin_common_dir_uidx repo
CREATE UNIQUE INDEX IF NOT EXISTS repo_origin_common_dir_uidx ON repo (origin, common_dir) WHERE common_dir IS NOT NULL

index repo_origin_origin_url_uidx repo
CREATE UNIQUE INDEX IF NOT EXISTS repo_origin_origin_url_uidx ON repo (origin, origin_url) WHERE origin_url IS NOT NULL

index round_binding_number_uidx round
CREATE UNIQUE INDEX IF NOT EXISTS round_binding_number_uidx ON round (binding_id, number)

index round_candidate_idx round
CREATE INDEX IF NOT EXISTS round_candidate_idx ON round (harness, provider, model)

index round_started_at_idx round
CREATE INDEX IF NOT EXISTS round_started_at_idx ON round (started_at)

index sqlite_autoindex_artifact_1 artifact


index sqlite_autoindex_binding_1 binding


index sqlite_autoindex_binding_event_1 binding_event


index sqlite_autoindex_binding_record_1 binding_record


index sqlite_autoindex_chain_event_1 chain_event


index sqlite_autoindex_chains_1 chains


index sqlite_autoindex_config_doc_1 config_doc


index sqlite_autoindex_event_1 event


index sqlite_autoindex_ingest_cursor_1 ingest_cursor


index sqlite_autoindex_installation_1 installation


index sqlite_autoindex_kv_1 kv


index sqlite_autoindex_mastermind_1 mastermind


index sqlite_autoindex_repo_1 repo


index sqlite_autoindex_round_1 round


index sqlite_autoindex_round_file_1 round_file


index sqlite_autoindex_secret_1 secret


