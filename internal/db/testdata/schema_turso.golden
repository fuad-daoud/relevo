trigger sync_outbox_transcript_del transcript
CREATE TRIGGER IF NOT EXISTS sync_outbox_transcript_del AFTER DELETE ON transcript BEGIN INSERT INTO sync_outbox (tbl, pk, op, origin) VALUES ('transcript', json_array (OLD.id), 'delete', CASE OLD.owner_kind WHEN 'round' THEN (SELECT origin FROM binding WHERE id = (SELECT binding_id FROM round WHERE id = OLD.owner_id)) WHEN 'mastermind' THEN (SELECT origin FROM mastermind WHERE id = OLD.owner_id) ELSE NULL END); END

