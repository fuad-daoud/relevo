index sqlite_autoindex_transcript_1 transcript


index transcript_owner_seq_uidx transcript
CREATE UNIQUE INDEX IF NOT EXISTS transcript_owner_seq_uidx ON transcript (owner_kind, owner_id, seq)

table artifact artifact
CREATE TABLE artifact (id TEXT PRIMARY KEY, round_id TEXT NOT NULL REFERENCES round (id), kind TEXT NOT NULL, consult_id TEXT NOT NULL DEFAULT '', text TEXT NOT NULL, bytes INTEGER NOT NULL, sha256 TEXT NOT NULL, captured_at TEXT NOT NULL)

table binding binding
CREATE TABLE binding (id TEXT PRIMARY KEY, name TEXT NOT NULL, repo_id TEXT, mastermind_id TEXT, feature TEXT, forked_from_binding_id TEXT, forked_from_round INTEGER, cwd TEXT NOT NULL, worktree TEXT, branch TEXT, base_commit TEXT, tier TEXT, gate TEXT, builder_mode TEXT NOT NULL, server TEXT, created_at TEXT NOT NULL, final_state TEXT, archived_at TEXT, archive_path TEXT, ingest_source TEXT NOT NULL, ticket TEXT, origin TEXT NOT NULL DEFAULT '', FOREIGN KEY (repo_id) REFERENCES repo(id), FOREIGN KEY (mastermind_id) REFERENCES mastermind(id), FOREIGN KEY (forked_from_binding_id) REFERENCES binding(id))

table binding_event binding_event
CREATE TABLE binding_event (record_id TEXT NOT NULL REFERENCES binding_record (id) ON DELETE CASCADE, seq INTEGER NOT NULL, ts TEXT NOT NULL, round INTEGER NOT NULL, direction TEXT NOT NULL, kind TEXT NOT NULL, confirmed INTEGER NOT NULL, delivered_at TEXT, route TEXT, entry_json TEXT NOT NULL, PRIMARY KEY (record_id, seq))

table binding_record binding_record
CREATE TABLE binding_record (id TEXT PRIMARY KEY, owner TEXT NOT NULL DEFAULT '', name TEXT NOT NULL, state TEXT NOT NULL, round INTEGER NOT NULL, cwd TEXT NOT NULL, record_json TEXT NOT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL, viewed_at TEXT, archived_at TEXT, origin TEXT NOT NULL DEFAULT '', link_origin TEXT, link_id TEXT)

table chain_event chain_event
CREATE TABLE chain_event (chain_id TEXT NOT NULL REFERENCES chains (id) ON DELETE CASCADE, seq INTEGER NOT NULL, ts TEXT NOT NULL, phase TEXT NOT NULL, step TEXT NOT NULL, member TEXT NOT NULL, round INTEGER NOT NULL, event TEXT NOT NULL, "action" TEXT NOT NULL, reason TEXT NOT NULL DEFAULT '', PRIMARY KEY (chain_id, seq))

table chains chains
CREATE TABLE chains (id TEXT PRIMARY KEY, origin TEXT NOT NULL DEFAULT '', owner TEXT NOT NULL DEFAULT '', name TEXT NOT NULL, status TEXT NOT NULL, reason TEXT NOT NULL DEFAULT '', phase TEXT NOT NULL, step TEXT NOT NULL, "plan" INTEGER NOT NULL, plans INTEGER NOT NULL, plan_paths TEXT NOT NULL, corrections INTEGER NOT NULL DEFAULT 0, awaiting_member TEXT NOT NULL DEFAULT '', awaiting_round INTEGER NOT NULL DEFAULT 0, settings TEXT NOT NULL DEFAULT '{}', builder TEXT NOT NULL, reviewer TEXT NOT NULL DEFAULT '', planner TEXT NOT NULL DEFAULT '', security TEXT NOT NULL DEFAULT '', base TEXT NOT NULL DEFAULT '', branch TEXT NOT NULL DEFAULT '', repo TEXT NOT NULL DEFAULT '', worktree TEXT NOT NULL DEFAULT '', feature TEXT NOT NULL DEFAULT '', ticket TEXT NOT NULL DEFAULT '', server TEXT NOT NULL DEFAULT '', mastermind_id TEXT NOT NULL DEFAULT '', created_at TEXT NOT NULL, updated_at TEXT NOT NULL)

table config_doc config_doc
CREATE TABLE config_doc (name TEXT PRIMARY KEY, body TEXT NOT NULL, updated_at TEXT NOT NULL)

table config_import config_import
CREATE TABLE config_import (id INTEGER PRIMARY KEY, name TEXT NOT NULL, source_path TEXT NOT NULL, body BLOB NOT NULL, imported_at TEXT NOT NULL)

table config_meta config_meta
CREATE TABLE config_meta (id INTEGER PRIMARY KEY CHECK (id = 1), version INTEGER NOT NULL)

table config_revision config_revision
CREATE TABLE config_revision (rev INTEGER PRIMARY KEY, at TEXT NOT NULL, source TEXT NOT NULL, message TEXT NOT NULL, version INTEGER NOT NULL, changes TEXT NOT NULL, snapshot TEXT NOT NULL)

table event event
CREATE TABLE event (id TEXT PRIMARY KEY, binding_id TEXT NOT NULL REFERENCES binding (id), round_id TEXT REFERENCES round (id), seq INTEGER NOT NULL, ts TEXT NOT NULL, kind TEXT NOT NULL, direction TEXT NOT NULL, note TEXT, path TEXT, delivered_at TEXT, confirmed INTEGER NOT NULL, late INTEGER NOT NULL, flagged INTEGER, flagged_by TEXT, entry_json TEXT NOT NULL)

table ingest_cursor ingest_cursor
CREATE TABLE ingest_cursor (source TEXT PRIMARY KEY, byte_offset INTEGER NOT NULL, head_sha TEXT NOT NULL, whole_sha TEXT, updated_at TEXT NOT NULL)

table installation installation
CREATE TABLE installation (id TEXT PRIMARY KEY, label TEXT NOT NULL, first_seen TEXT NOT NULL, last_seen TEXT NOT NULL)

table kv kv
CREATE TABLE kv ("key" TEXT PRIMARY KEY, value_json TEXT NOT NULL, updated_at TEXT NOT NULL)

table mastermind mastermind
CREATE TABLE mastermind (id TEXT PRIMARY KEY, harness_kind TEXT NOT NULL, session_id TEXT NOT NULL, transcript_locator TEXT, first_seen TEXT NOT NULL, last_seen TEXT NOT NULL, origin TEXT NOT NULL DEFAULT '')

table repo repo
CREATE TABLE repo (id TEXT PRIMARY KEY, origin_url TEXT, common_dir TEXT, first_seen TEXT NOT NULL, mastermind_consent TEXT, consent_at TEXT, origin TEXT NOT NULL DEFAULT '')

table round round
CREATE TABLE round (id TEXT PRIMARY KEY, binding_id TEXT NOT NULL, number INTEGER NOT NULL, started_at TEXT NOT NULL, closed_at TEXT, outcome TEXT NOT NULL, candidate TEXT, harness TEXT, provider TEXT, model TEXT, mode TEXT, tier TEXT, commits INTEGER, tree TEXT, gate_result TEXT, gate_exit INTEGER, gate_duration_ms INTEGER, in_tokens INTEGER, cache_tokens INTEGER, write_tokens INTEGER, out_tokens INTEGER, cost_usd REAL, cost_basis TEXT, report_outcome TEXT, switches INTEGER NOT NULL, actor TEXT NOT NULL DEFAULT 'builder', FOREIGN KEY (binding_id) REFERENCES binding(id))

table round_file round_file
CREATE TABLE round_file (record_id TEXT NOT NULL, name TEXT NOT NULL, round INTEGER NOT NULL, body BLOB NOT NULL, bytes INTEGER NOT NULL, sha256 TEXT NOT NULL, mtime TEXT NOT NULL, sealed_at TEXT NOT NULL, body_codec INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (record_id, name), FOREIGN KEY (record_id) REFERENCES binding_record(id) ON DELETE CASCADE)

table schema_version schema_version
CREATE TABLE schema_version (version INTEGER PRIMARY KEY, applied_at TEXT)

table secret secret
CREATE TABLE secret (name TEXT PRIMARY KEY, value BLOB NOT NULL, updated_at TEXT NOT NULL)

table session_consent session_consent
CREATE TABLE session_consent (harness_kind TEXT NOT NULL, session_id TEXT NOT NULL, answer TEXT, answer_at TEXT, told TEXT, told_at TEXT, PRIMARY KEY (harness_kind, session_id))

table transcript transcript
CREATE TABLE transcript (id TEXT PRIMARY KEY, owner_kind TEXT NOT NULL, owner_id TEXT NOT NULL, seq INTEGER NOT NULL, ts TEXT, record_json TEXT NOT NULL, rendered TEXT NOT NULL, record_json_codec INTEGER NOT NULL DEFAULT 0, rendered_codec INTEGER NOT NULL DEFAULT 0)

schema_versions have=16 know=16
