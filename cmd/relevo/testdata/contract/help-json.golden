{"tool":"relevo","version":1,"build":"<VERSION>","verbs":[{"name":"bind","summary":"bind this MasterMind to a runner over a worktree or an existing tree","args":"[NAME] [--json]","flags":["--actor","--allow-yolo","--base","--branch","--candidate","--cwd","--feature","--gate","--json","--local","--mastermind","--name","--no-feature","--no-gate","--rebind","--regate","--resume","--server","--ticket","--tier","--timeout","--worktree"],"output":"json:BindDoc","exit":[0,1,2],"errors":["binding_not_found","conflict","gate_active","internal","policy_refused","refused","tier_cap","usage"]},{"name":"board","summary":"open a live or repo board: a single-file HTML page, or an Excalidraw scene by its explicit path","args":"[path] [--board NAME] [--mastermind M] [--theme NAME] [--no-open]","flags":["--board","--mastermind","--no-open","--theme"],"output":"","exit":[0,1,2],"errors":["internal","mastermind_not_found","refused","usage"]},{"name":"board annotate","summary":"append one text element to a scene in the repo","args":"\u003cfile\u003e --text S [--x X --y Y]","flags":["--text","--x","--y"],"output":"","exit":[0,1,2],"errors":["internal","refused","usage"]},{"name":"board comment","summary":"append one comment to a live or repo board scene","args":"[path] [--board NAME] --text S [--x X --y Y] [--by B]","flags":["--board","--by","--text","--x","--y"],"output":"","exit":[0,1,2],"errors":["internal","mastermind_not_found","refused","usage"]},{"name":"board comments","summary":"list a live or repo board scene's comments in scene order","args":"[path] [--board NAME] [--json]","flags":["--board","--json"],"output":"json:[]Comment","exit":[0,1,2],"errors":["internal","mastermind_not_found","refused","usage"]},{"name":"board promote","summary":"copy a live board into the repo as a committed board.html","args":"[--board NAME] [--mastermind M] [--to SLUG] [--force]","flags":["--board","--force","--mastermind","--to"],"output":"","exit":[0,1,2],"errors":["internal","mastermind_not_found","refused","usage"]},{"name":"board text","summary":"list a scene's text elements","args":"\u003cfile\u003e [--json]","flags":["--json"],"output":"json:[]board.AgentText","exit":[0,1,2],"errors":["internal","refused","usage"]},{"name":"board url","summary":"print the live board's URL for a shell copy","args":"[--board NAME] [--mastermind M]","flags":["--board","--mastermind"],"output":"","exit":[0,1,2],"errors":["internal","mastermind_not_found","not_available","refused","usage"]},{"name":"bugreport","summary":"assemble a local, redacted bug-report bundle and print the gh line","args":"[--name N] [--round N] [--logs] [--raw] [--out PATH] [--title T] [--body FILE] [--stdout|--json|--gh]","flags":["--body","--gh","--json","--logs","--name","--out","--raw","--round","--stdout","--title"],"output":"json:bugreport.Doc","exit":[0,1,2],"errors":["internal","not_available","usage"]},{"name":"chain","summary":"start a chain: build, review and correct across a list of plans","args":"--name \u003cn\u003e (--plan \u003cfile\u003e [--plan \u003cfile\u003e...] (--feature \u003clabel\u003e|--no-feature) | --resume) [--workflow \u003cname|path\u003e] [--param k=v] [--task \u003ctext\u003e|--task-file \u003cpath\u003e] [--dry-run] [--json]","flags":["--base","--dry-run","--feature","--from","--gate","--json","--mastermind","--max-corrections","--name","--no-feature","--no-gate","--no-security","--param","--plan","--planner-actor","--regate","--resume","--reviewer-actor","--security","--security-actor","--server","--task","--task-file","--ticket","--workflow"],"output":"json:ChainDoc","exit":[0,1,2],"errors":["binding_not_found","conflict","gate_active","internal","policy_refused","refused","tier_cap","usage"]},{"name":"config","summary":"show the actors, the current pick and the candidates","args":"[--probe [token...]] [--json]","flags":["--json","--probe"],"output":"json:ConfigView","exit":[0,1,2],"errors":["config_invalid","internal","usage"]},{"name":"config agents","summary":"write the starter agent definitions into the harness config","args":"[--kind \u003cagy|claude|opencode\u003e] [--agent \u003cname\u003e] [--force] [--dry-run] [--json]","flags":["--agent","--dry-run","--force","--json","--kind"],"output":"json:ConfigAgentsDoc","exit":[0,1,2],"errors":["internal","usage"]},{"name":"config edit","summary":"edit the configuration document in $EDITOR","args":"","flags":[],"output":"","exit":[0,1,2],"errors":["usage"]},{"name":"config export","summary":"print the whole configuration document","args":"[--json]","flags":["--json"],"output":"json:config document","exit":[0,1,2],"errors":["config_invalid","usage"]},{"name":"config get","summary":"print the JSON value at a path in the configuration","args":"\u003csection\u003e[.\u003ckey\u003e...] [--json]","flags":["--json"],"output":"json:the value at the path","exit":[0,1,2],"errors":["config_path_not_set","internal","usage"]},{"name":"config import","summary":"import a configuration document from a file or stdin","args":"\u003cfile|-\u003e [--json]","flags":["--json"],"output":"json:ConfigImportDoc","exit":[0,1,2],"errors":["config_invalid","internal","usage"]},{"name":"config init","summary":"write the starter configuration, candidates, policy and actors","args":"[--force] [--no-agents] [--json]","flags":["--force","--json","--no-agents"],"output":"json:ConfigImportDoc","exit":[0,1,2],"errors":["conflict","internal","usage"]},{"name":"config log","summary":"list the configuration revisions, or show one","args":"[-n N] [--rev N] [--json]","flags":["--json","--n","--rev"],"output":"json:one configuration revision and its changes","exit":[0,1,2],"errors":["internal","revision_not_found","usage"]},{"name":"config rollback","summary":"restore an earlier configuration revision","args":"\u003crev\u003e [--yes] [-m \u003cmessage\u003e]","flags":["--m","--yes"],"output":"","exit":[0,1,2],"errors":["usage"]},{"name":"config secret","summary":"store or forget the typesafe and client.key secrets","args":"set|rm|list","flags":[],"output":"","exit":[0,2],"errors":[]},{"name":"config secret list","summary":"print the stored secret names, never their values","args":"","flags":["--json"],"output":"json:[]string","exit":[0,1,2],"errors":["config_invalid","internal","usage"]},{"name":"config secret rm","summary":"remove a stored secret","args":"\u003ctypesafe|client.key\u003e [--json]","flags":["--json"],"output":"json:ConfigSecretDoc","exit":[0,1,2],"errors":["internal","usage"]},{"name":"config secret set","summary":"store a secret read from stdin","args":"\u003ctypesafe|client.key\u003e [--json]","flags":["--json"],"output":"json:ConfigSecretDoc","exit":[0,1,2],"errors":["internal","usage"]},{"name":"config server","summary":"this machine's remote-builder identity and its server list","args":"add|rm|list|key","flags":[],"output":"","exit":[0,2],"errors":[]},{"name":"config server add","summary":"record a remote-builder server","args":"\u003cname\u003e \u003curl\u003e (--fingerprint F | --ca system | --insecure) [--json]","flags":["--ca","--fingerprint","--insecure","--json"],"output":"json:ConfigServerAddDoc","exit":[0,1,2],"errors":["internal","remote_unreachable","usage"]},{"name":"config server key","summary":"print this client's id and the enrolment line a server admin needs","args":"[--enroll-line] [--json]","flags":["--enroll-line","--json"],"output":"json:{id,enroll_line}","exit":[0,1,2],"errors":["internal","usage"]},{"name":"config server list","summary":"print one row per configured server","args":"","flags":["--json"],"output":"json:[]server","exit":[0,1,2],"errors":["config_invalid","internal","usage"]},{"name":"config server rm","summary":"forget a configured server","args":"\u003cname\u003e [--json]","flags":["--json"],"output":"json:ConfigServerRmDoc","exit":[0,1,2],"errors":["conflict","internal","server_not_found","usage"]},{"name":"config set","summary":"set a configuration section or key to a JSON value","args":"\u003csection\u003e[.\u003ckey\u003e...] \u003cjson\u003e [--json]","flags":["--json"],"output":"json:ConfigWriteDoc","exit":[0,1,2],"errors":["config_invalid","internal","usage"]},{"name":"config unset","summary":"remove a configuration section or key","args":"\u003csection\u003e[.\u003ckey\u003e...] [--json]","flags":["--json"],"output":"json:ConfigWriteDoc","exit":[0,1,2],"errors":["config_invalid","internal","usage"]},{"name":"config workflow","summary":"list, add, remove, show or edit saved workflows","args":"add|rm|show|edit","flags":[],"output":"","exit":[0,2],"errors":[]},{"name":"config workflow add","summary":"validate and save a workflow from a YAML or JSON file","args":"\u003cfile\u003e [--replace] [--force]","flags":["--force","--replace"],"output":"","exit":[0,1,2],"errors":["config_invalid","conflict","internal","usage"]},{"name":"config workflow edit","summary":"edit a saved workflow's source in $EDITOR","args":"\u003cname\u003e","flags":[],"output":"","exit":[0,1,2],"errors":["config_invalid","config_path_not_set","internal","usage"]},{"name":"config workflow rm","summary":"forget a saved workflow","args":"\u003cname\u003e","flags":[],"output":"","exit":[0,1,2],"errors":["config_path_not_set","internal","usage"]},{"name":"config workflow show","summary":"print a saved workflow's source, or its definition with --json","args":"\u003cname\u003e [--json]","flags":["--json"],"output":"json:the stored definition","exit":[0,1,2],"errors":["config_path_not_set","internal","usage"]},{"name":"daemon","summary":"run the long-running reconciler","args":"[--interval D] [--check] [--pprof \u003cpath\u003e]","flags":["--auto-exit-after","--check","--interval","--pprof","--preflight"],"output":"","exit":[0,1,2],"errors":["usage"]},{"name":"db","summary":"read relevo.db without opening it as a writer","args":"query \u003cSQL\u003e [--json] [--limit N] [--timeout D] [--max-bytes N]","flags":["--json","--limit","--max-bytes","--timeout"],"output":"","exit":[0,1,2],"errors":["conflict","internal","refused","usage"]},{"name":"db query","summary":"run one read-only SQL statement against relevo.db; RECURSIVE is refused as a first line, not the guarantee","args":"\u003cSQL\u003e [--json] [--limit N] [--timeout D] [--max-bytes N]","flags":["--json","--limit","--max-bytes","--timeout"],"output":"json:{columns,rows}","exit":[0,1,2],"errors":["conflict","internal","refused","usage"]},{"name":"doctor","summary":"preflight check: plugin, daemon, harness binaries, roles, release","args":"","flags":["--json"],"output":"json:DoctorDoc","exit":[0,1,2],"errors":["config_invalid","internal","usage"]},{"name":"done","summary":"mark a binding done; relaying stops","args":"[NAME] [--json]","flags":["--json","--name","--pick"],"output":"json:DoneDoc","exit":[0,1,2],"errors":["binding_not_found","conflict","internal","refused","usage"]},{"name":"gate","summary":"list this machine's gates, gate a provider, or clear one","args":"[\u003ctoken\u003e] [--for D] [--reason S] [--json] | --clear \u003cprovider|token\u003e | --serve","flags":["--clear","--for","--json","--reason","--serve","--state"],"output":"json:[]GateRow; set/clear: GateDoc","exit":[0,1,2],"errors":["internal","not_available","policy_refused","usage"]},{"name":"help","summary":"print the usage text, or the registry document with --json","args":"[--json [\u003cverb\u003e]]","flags":["--json"],"output":"json:registry document","exit":[0,2],"errors":["usage"]},{"name":"history","summary":"round history as JSON","args":"[--binding B] [--since D] [--limit N] [-q QUERY] [--json]","flags":["--binding","--by","--feature","--here","--json","--limit","--mastermind","--q","--rows","--since","--ticket"],"output":"json:[]RoundRow","exit":[0,1,2],"errors":["internal","usage"]},{"name":"mastermind","summary":"register this MasterMind, and list, rename or forget records","args":"init|notice|enable|disable|reset|guide|list|rename|forget","flags":[],"output":"","exit":[0,2],"errors":[]},{"name":"mastermind disable","summary":"withdraw consent for this session or repository","args":"[--repo] [--kind K --session S] [--json]","flags":["--json","--kind","--repo","--session"],"output":"json:MasterMindDoc","exit":[0,1,2],"errors":["conflict","internal","refused","usage"]},{"name":"mastermind enable","summary":"consent this session or repository to relevo","args":"[--repo] [--kind K --session S] [--json]","flags":["--json","--kind","--repo","--session"],"output":"json:MasterMindDoc","exit":[0,1,2],"errors":["conflict","internal","refused","usage"]},{"name":"mastermind forget","summary":"forget a MasterMind record","args":"\u003cid|name\u003e [--json]","flags":["--json"],"output":"json:MasterMindDoc","exit":[0,1,2],"errors":["conflict","internal","mastermind_not_found","usage"]},{"name":"mastermind guide","summary":"print the MasterMind guide, or this session's consent document","args":"[--cwd DIR] [--kind K --session S] [--json]","flags":["--cwd","--json","--kind","--session"],"output":"json:the consent document {\"state\",\"text\",\"repo\",\"id\",\"name\"}","exit":[0,1,2],"errors":["internal","usage"]},{"name":"mastermind init","summary":"register this MasterMind, or re-attach an existing record","args":"[--name N] [--kind K --session S] [--hook claude] [--json]","flags":["--hook","--json","--kind","--name","--session"],"output":"json:MasterMindDoc","exit":[0,1,2],"errors":["conflict","internal","refused","usage"]},{"name":"mastermind list","summary":"list the MasterMind records","args":"[--json]","flags":["--json"],"output":"json:[]a record per MasterMind","exit":[0,1,2],"errors":["internal","usage"]},{"name":"mastermind notice","summary":"the UserPromptSubmit hook that reports a status change","args":"--hook claude","flags":["--hook"],"output":"","exit":[0,1,2],"errors":["usage"]},{"name":"mastermind rename","summary":"rename a MasterMind record","args":"\u003cid|name\u003e \u003cnew-name\u003e [--json]","flags":["--json"],"output":"json:MasterMindRenameDoc","exit":[0,1,2],"errors":["conflict","internal","mastermind_not_found","usage"]},{"name":"mastermind reset","summary":"forget this session's or repository's consent answer","args":"[--kind K --session S] [--json]","flags":["--json","--kind","--session"],"output":"json:MasterMindDoc","exit":[0,1,2],"errors":["internal","refused","usage"]},{"name":"mcp","summary":"run an MCP server over stdio for a Claude Code MasterMind","args":"[--kind opencode] [--mastermind ID]","flags":["--kind","--mastermind"],"output":"","exit":[0,1,2],"errors":["usage"]},{"name":"push","summary":"hold this MasterMind's push claim and write its round events to the mod on stdout","args":"[--ack \u003cbinding\u003e \u003cseq\u003e] [--mastermind ID] [--json]","flags":["--ack","--json","--mastermind"],"output":"json:PushAckDoc; the long form is already NDJSON","exit":[0,1,2],"errors":["binding_not_found","internal","mastermind_mismatch","push_already_confirmed","push_no_claim","push_not_admitted","push_seq_not_found","usage"]},{"name":"send","summary":"stage a plan file as the current round and start the runner","args":"--file \u003cplan\u003e [NAME] [--json]","flags":["--allow-yolo","--candidate","--dry-run","--file","--force","--json","--name","--no-verify","--regate","--tier","--verify"],"output":"json:SendDoc; --dry-run: relevo.DryRun","exit":[0,1,2],"errors":["binding_not_found","conflict","gate_active","internal","policy_refused","refused","round_cap","tier_cap","usage"]},{"name":"serve","summary":"run the remote-builder server (listener + daemon)","args":"[--listen :7777] [--state \u003cdir\u003e] [--interval 2s]","flags":["--insecure-http","--interval","--listen","--max-builders","--max-bundle-bytes","--public-host","--state"],"output":"","exit":[0,1,2],"errors":["usage"]},{"name":"serve clients","summary":"list the enrolled clients","args":"[--state \u003cdir\u003e]","flags":["--json","--state"],"output":"json:[]client","exit":[0,1,2],"errors":["internal","not_available","usage"]},{"name":"serve enroll","summary":"enroll a client's public key","args":"--label \u003clabel\u003e --key \"\u003ced25519 line\u003e\" [--user \u003cunix user\u003e] [--state \u003cdir\u003e] [--json]","flags":["--json","--key","--label","--state","--user"],"output":"json:ServeEnrollDoc","exit":[0,1,2],"errors":["conflict","internal","usage"]},{"name":"serve fingerprint","summary":"print the server certificate's fingerprint","args":"[--state \u003cdir\u003e]","flags":["--json","--state"],"output":"json:{\"fingerprint\"}","exit":[0,1,2],"errors":["internal","not_available","usage"]},{"name":"serve gc","summary":"unbind bindings abandoned for longer than a threshold","args":"--abandoned \u003cduration\u003e [--dry-run] [--state \u003cdir\u003e] [--json]","flags":["--abandoned","--dry-run","--json","--state"],"output":"json:ServeGCDoc","exit":[0,1,2],"errors":["internal","not_available","usage"]},{"name":"serve init","summary":"initialise the serve state root and its certificate","args":"[--host \u003cname\u003e]... [--state \u003cdir\u003e] [--json]","flags":["--host","--json","--state"],"output":"json:ServeInitDoc","exit":[0,1,2],"errors":["internal","usage"]},{"name":"serve revoke","summary":"revoke an enrolled client","args":"\u003cid\u003e [--state \u003cdir\u003e] [--json]","flags":["--json","--state"],"output":"json:ServeRevokeDoc","exit":[0,1,2],"errors":["client_not_found","internal","not_available","usage"]},{"name":"serve status","summary":"print the census as JSON","args":"[--json] [--state \u003cdir\u003e]","flags":["--json","--state"],"output":"json:census","exit":[0,1,2],"errors":["internal","not_available","usage"]},{"name":"serve ui","summary":"watch the server's queue in a terminal","args":"[--state \u003cdir\u003e] [--interval 2s]","flags":["--interval","--state"],"output":"","exit":[0,1,2],"errors":["usage"]},{"name":"serve unbind","summary":"unbind one of an owner's bindings on the server host","args":"--owner \u003clabel|id\u003e \u003cname\u003e [--state \u003cdir\u003e] [--force] [--json]","flags":["--force","--json","--owner","--state"],"output":"json:ServeUnbindDoc","exit":[0,1,2],"errors":["binding_not_found","client_not_found","conflict","internal","not_available","usage"]},{"name":"show","summary":"one round's plan, report, diff, drift, gate, findings, log or transcript","args":"[NAME] [--round N] [--diff [--stat|--anchors]] [--log [--follow --after N]] [--trace] [--json] [--peek]","flags":["--after","--anchors","--artifact","--artifacts","--diff","--drift","--findings","--follow","--gate","--json","--log","--output","--owner","--peek","--prompt","--report","--round","--stat","--state","--trace","--transcript","--workflow"],"output":"json:ShowResult; --log prints NDJSON events","exit":[0,1,2],"errors":["artifact_not_found","binding_not_found","internal","round_not_found","usage"]},{"name":"status","summary":"one row per binding: round, state, live pane status, what is pending","args":"[--all] [--name NAME] [--line] [--chains] [--json]","flags":["--all","--all-masterminds","--chains","--json","--line","--mastermind","--name"],"output":"json:view.Report; --line: json:view.StatusLineDoc; --chains: json:relevo.ChainsDoc","exit":[0,1,2],"errors":["binding_not_found","internal","usage"]},{"name":"stop","summary":"kill the runner process and close its round unless a report is on disk","args":"[NAME] [--json]","flags":["--json","--name"],"output":"json:StopDoc","exit":[0,1,2],"errors":["binding_not_found","internal","usage"]},{"name":"ui","summary":"the cockpit: :fleet, :rounds [query], :round \u003cbinding\u003e [N]","args":"[:view [args]]","flags":["--interval"],"output":"","exit":[0,1,2],"errors":["usage"]},{"name":"unbind","summary":"forget a binding, deleting or archiving its directory","args":"[NAME] [--done] [--delete] [--dry-run] [--json]","flags":["--all-masterminds","--archive","--delete","--done","--dry-run","--json","--mastermind","--name","--pick","--sweep"],"output":"json:UnbindDoc; --done: gcDoc; --sweep: sweepDoc","exit":[0,1,2],"errors":["binding_not_found","conflict","internal","refused","usage"]},{"name":"update","summary":"replace this release binary with the latest release, checksum-verified","args":"[--check] [--to vX.Y.Z] [--release] [--json]","flags":["--check","--json","--release","--to"],"output":"json:updateDoc","exit":[0,1,2],"errors":["internal","refused","remote_unreachable","usage"]},{"name":"version","summary":"print the relevo version","args":"","flags":["--json"],"output":"json:{\"version\"}","exit":[0,2],"errors":["usage"]},{"name":"wait","summary":"block until a round closes or needs you, then print the pending report","args":"[NAME] [--any] [--round N] [--peek] [--timeout D] [--json]","flags":["--any","--json","--name","--peek","--round","--timeout"],"output":"json:WaitDoc","exit":[0,2,3,4,5,6,124],"errors":["binding_not_found","internal","round_not_found","usage"]}],"errors":{"artifact_not_found":{"exit":1,"next":"relevo history"},"binding_not_found":{"exit":1,"next":"relevo status --all"},"client_not_found":{"exit":1,"next":"relevo serve clients"},"config_invalid":{"exit":1,"next":"relevo config edit"},"config_path_not_set":{"exit":1,"next":"relevo config export"},"conflict":{"exit":1,"next":""},"gate_active":{"exit":1,"next":"relevo gate"},"internal":{"exit":1,"next":"relevo bugreport"},"mastermind_mismatch":{"exit":1,"next":""},"mastermind_not_found":{"exit":1,"next":"relevo mastermind list"},"no_daemon":{"exit":1,"next":"relevo daemon"},"not_available":{"exit":1,"next":""},"policy_refused":{"exit":1,"next":""},"push_already_confirmed":{"exit":1,"next":""},"push_no_claim":{"exit":1,"next":""},"push_not_admitted":{"exit":1,"next":""},"push_seq_not_found":{"exit":1,"next":""},"refused":{"exit":2,"next":""},"remote_auth":{"exit":1,"next":""},"remote_unreachable":{"exit":1,"next":""},"revision_not_found":{"exit":1,"next":"relevo config log"},"round_cap":{"exit":1,"next":"relevo bind"},"round_not_found":{"exit":1,"next":"relevo history"},"server_not_found":{"exit":1,"next":"relevo config server list"},"tier_cap":{"exit":1,"next":""},"unmigrated":{"exit":1,"next":""},"usage":{"exit":2,"next":"relevo help"}}}
